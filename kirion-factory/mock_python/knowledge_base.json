 demo"},{"id":"local","label":"Local username/password"},{"id":"passwordless","label":"Passwordless"},{"id":"sso","label":"SSO/OIDC"}]},{"id":"data_sensitivity","group":"security","prompt":"How sensitive is the data?","why":"This raises or lowers default security controls.","options":[{"id":"public","label":"Public"},{"id":"internal","label":"Internal"},{"id":"confidential","label":"Confidential"},{"id":"restricted","label":"Restricted"}]},{"id":"audit","group":"security","prompt":"How much auditability is required?","why":"Audit depth affects logs and destructive action controls.","options":[{"id":"none","label":"None"},{"id":"basic","label":"Basic activity log"},{"id":"full","label":"Full audit history"},{"id":"immutable","label":"Append-only / immutable-style audit"}]},{"id":"persistence","group":"data","prompt":"What persistence should this mock demonstrate?","why":"The mock can stay dependency-free while showing different storage contracts.","options":[{"id":"browser","label":"Browser localStorage"},{"id":"json","label":"JSON file concept"},{"id":"sqlite","label":"SQLite concept"},{"id":"api","label":"External API concept"}]},{"id":"data_shape","group":"data","prompt":"What data shape dominates?","why":"This selects table/card/form patterns.","options":[{"id":"records","label":"Structured records"},{"id":"documents","label":"Documents/files"},{"id":"events","label":"Event stream"},{"id":"mixed","label":"Mixed records + documents"}]},{"id":"volume","group":"data","prompt":"What scale should the design assume?","why":"Scale changes paging, filtering, and index recommendations.","options":[{"id":"small","label":"Small <10k records"},{"id":"medium","label":"Medium 10k–1M"},{"id":"large","label":"Large >1M"},{"id":"burst","label":"Bursty/event-heavy"}]},{"id":"destructive_actions","group":"security","prompt":"Are destructive actions present?","why":"Deletion/disable flows need confirmations and audit controls.","options":[{"id":"none","label":"No destructive actions